<Window x:Class="Aurum.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Aurum.App.Controls"
        Title="Aurum — AtlasOS Companion"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="1240"
        Height="820"
        MinWidth="1080"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}"
        FontFamily="{StaticResource UiFontFamily}"
        Foreground="{StaticResource TextBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="238" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDEBAR -->
        <Border Grid.Column="0"
                Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="22,24,22,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="AURUM"
                               Foreground="{StaticResource AccentBrush}"
                               FontFamily="{StaticResource BrandFontFamily}"
                               FontSize="27"
                               FontWeight="Bold" />
                    <TextBlock Margin="0,4,0,0"
                               Text="ATLASOS COMPANION"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="10"
                               FontWeight="SemiBold" />

                    <!-- Global Mode Switcher (Simple / Pro) -->
                    <Border Margin="0,16,0,0"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            
                            <Button Padding="0,7"
                                    Command="{Binding SetSimpleModeCommand}"
                                    Cursor="Hand"
                                    BorderThickness="0">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSimpleModeVisible}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource ElevatedBrush}" />
                                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="👤 Обычный" FontSize="11" />
                            </Button>

                            <Button Grid.Column="1"
                                    Padding="0,7"
                                    Command="{Binding SetProModeCommand}"
                                    Cursor="Hand"
                                    BorderThickness="0">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsProModeVisible}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource ElevatedBrush}" />
                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="🛠️ Про" FontSize="11" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Standalone Monitoring HUD Button -->
                    <Button Margin="0,10,0,0"
                            Padding="12,10"
                            Command="{Binding OpenMonitoringCommand}"
                            HorizontalContentAlignment="Stretch"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BaseButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMonitoringVisible}" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        <Setter Property="Background" Value="{StaticResource ElevatedBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" Background="{StaticResource AccentDarkBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="6">
                                <TextBlock Text="⚡" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Мониторинг" FontWeight="SemiBold" FontSize="12" />
                                <TextBlock Text="Датчики и задержки" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="●" Foreground="{StaticResource SuccessBrush}" FontSize="10" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <!-- Information & Safety Button -->
                    <Button Margin="0,7,0,0"
                            Padding="12,10"
                            Command="{Binding SetWelcomeModeCommand}"
                            HorizontalContentAlignment="Stretch"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BaseButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWelcomeVisible}" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        <Setter Property="Background" Value="{StaticResource ElevatedBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" Background="{StaticResource ElevatedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                                <TextBlock Text="ℹ️" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Информация" FontWeight="SemiBold" FontSize="12" />
                                <TextBlock Text="О программе и безопасность" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- Middle Content: Sidebar Quick Status Card -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Margin="0,12,0,0"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="11,10">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="БЫСТРЫЙ СТАТУС" Foreground="{StaticResource MutedBrush}" FontSize="9" FontWeight="Bold" />
                            </Grid>

                            <!-- Timer Status -->
                            <Border Margin="0,7,0,0" Background="{StaticResource ElevatedBrush}" Padding="8,4" CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="⏱️ Таймер" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" />
                                    <TextBlock Grid.Column="1" Text="{Binding TimerStatusBadge}" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="SemiBold" />
                                </Grid>
                            </Border>

                            <!-- MSI Status -->
                            <Border Margin="0,4,0,0" Background="{StaticResource ElevatedBrush}" Padding="8,4" CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🎮 Режим MSI" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" />
                                    <TextBlock Grid.Column="1" Text="{Binding MsiStatusBadge}" Foreground="{StaticResource SuccessBrush}" FontSize="10" FontWeight="SemiBold" />
                                </Grid>
                            </Border>

                            <!-- Active Tweaks -->
                            <Border Margin="0,4,0,0" Background="{StaticResource ElevatedBrush}" Padding="8,4" CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="⚡ Твиков" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock Text="{Binding AppliedTweaksCount}" Foreground="{StaticResource TextBrush}" FontSize="10" FontWeight="Bold" />
                                        <TextBlock Text="/" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="2,0" />
                                        <TextBlock Text="{Binding TotalTweaksCount}" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Quick DNS Flush Button -->
                            <Button Margin="0,7,0,0"
                                    Padding="8,5"
                                    Style="{StaticResource BaseButton}"
                                    Command="{Binding FlushDnsQuickCommand}"
                                    ToolTip="Очистить локальный кэш сопоставителя DNS Windows (ipconfig /flushdns)"
                                    HorizontalContentAlignment="Center"
                                    Cursor="Hand">
                                <TextBlock Text="⚡ Сбросить кэш DNS" FontSize="10" FontWeight="SemiBold" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Sidebar Bottom System Info Card -->
                    <Border Grid.Row="2"
                            VerticalAlignment="Bottom"
                            Margin="0,12,0,0"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="13,11">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="О СИСТЕМЕ" Foreground="{StaticResource MutedBrush}" FontSize="9" FontWeight="Bold" />
                                <TextBlock HorizontalAlignment="Right" Text="{Binding AccessLabel}" Foreground="{StaticResource AccentBrush}" FontSize="9" FontWeight="Bold" />
                            </Grid>
                            <TextBlock Margin="0,5,0,0" Text="{Binding WindowsLabel}" ToolTip="{Binding WindowsLabel}" TextTrimming="CharacterEllipsis" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Margin="0,2,0,0" Text="{Binding BuildLabel}" ToolTip="{Binding BuildLabel}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                            <Border Margin="0,8,0,0" Background="{StaticResource ElevatedBrush}" Padding="8,4" CornerRadius="4">
                                <Grid>
                                    <TextBlock Text="AtlasOS" Foreground="{StaticResource TextBrush}" FontSize="10" FontWeight="SemiBold" />
                                    <TextBlock HorizontalAlignment="Right" Text="{Binding AtlasLabel}" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- MAIN CONTENT AREA -->
        <Grid Grid.Column="1" Margin="34,24,34,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontFamily="{StaticResource DisplayFontFamily}"
                               FontSize="28"
                               FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Система под контролем" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWelcomeVisible}" Value="True">
                                        <Setter Property="Text" Value="Добро пожаловать в Aurum" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsMonitoringVisible}" Value="True">
                                        <Setter Property="Text" Value="Аппаратный мониторинг" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Margin="0,5,0,0"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="13">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Проверяемые изменения с точным возвратом к исходному состоянию." />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWelcomeVisible}" Value="True">
                                        <Setter Property="Text" Value="Центр контроля производительности, задержек и компонентов Windows." />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsMonitoringVisible}" Value="True">
                                        <Setter Property="Text" Value="Показатели датчиков, системного таймера и задержек в реальном времени." />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- Welcome Top Action -->
                <Button Grid.Column="1"
                        MinWidth="184"
                        VerticalAlignment="Center"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding SetSimpleModeCommand}"
                        Content="🚀 Начать настройку"
                        Visibility="{Binding IsWelcomeVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <!-- Simple Mode Top Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding IsSimpleModeVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button Margin="0,0,8,0"
                            Padding="16,9"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding ApplyAllSimpleCurrentCategoryCommand}"
                            Content="⚡ Включить все в разделе" />
                    <Button Padding="16,9"
                            Style="{StaticResource BaseButton}"
                            Command="{Binding RevertAllSimpleCommand}"
                            Content="🔄 Сбросить к исходным" />
                </StackPanel>

                <!-- Pro Mode Top Button -->
                <Button Grid.Column="1"
                        MinWidth="184"
                        VerticalAlignment="Center"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding ApplySelectedCommand}"
                        Content="Применить выбранное"
                        Visibility="{Binding IsProModeVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>

            <!-- AURUM WELCOME & INFO VIEW -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsWelcomeVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Margin="0,0,6,10">
                    <!-- Hero Banner -->
                    <Border Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="22,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="{StaticResource AccentDarkBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,10,0">
                                        <TextBlock Text="⚡ AURUM COMPANION" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" />
                                    </Border>
                                    <Border Background="{StaticResource ElevatedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,3">
                                        <TextBlock Text="v2.0 · Open Source &amp; Offline" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Margin="0,10,0,0"
                                           Text="Центр контроля, оптимизации и мониторинга Windows"
                                           FontFamily="{StaticResource DisplayFontFamily}"
                                           FontSize="21"
                                           FontWeight="SemiBold" />
                                <TextBlock Margin="0,5,0,0"
                                           Text="Автономный инструмент для оптимизации задержек ввода, стабильности фреймрейта и компонентов ОС."
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap" />

                                <!-- Badges row -->
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Border Margin="0,0,8,0" Padding="8,4" Background="{StaticResource ElevatedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                                        <TextBlock Text="🔒 100% Офлайн" Foreground="{StaticResource InfoBrush}" FontSize="10" FontWeight="SemiBold" />
                                    </Border>
                                    <Border Margin="0,0,8,0" Padding="8,4" Background="{StaticResource ElevatedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                                        <TextBlock Text="🛡️ Транзакционный откат" Foreground="{StaticResource SuccessBrush}" FontSize="10" FontWeight="SemiBold" />
                                    </Border>
                                    <Border Margin="0,0,8,0" Padding="8,4" Background="{StaticResource ElevatedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                                        <TextBlock Text="⚡ Zero Telemetry" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="SemiBold" />
                                    </Border>
                                    <Border Padding="8,4" Background="{StaticResource ElevatedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                                        <TextBlock Text="🎮 Low-Latency" Foreground="{StaticResource TextBrush}" FontSize="10" FontWeight="SemiBold" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <!-- Right decorative icon / emblem -->
                            <Border Grid.Column="1"
                                    Width="84"
                                    Height="84"
                                    Margin="20,0,0,0"
                                    Background="{StaticResource AccentDarkBrush}"
                                    BorderBrush="{StaticResource AccentBrush}"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    VerticalAlignment="Center">
                                <TextBlock Text="👑" FontSize="38" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Concise Safety Principles Card -->
                    <Border Margin="0,14,0,0"
                            Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="18,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🛡️" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="БЕЗОПАСНОСТЬ И ПРИНЦИПЫ РАБОТЫ"
                                           Foreground="{StaticResource TextBrush}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="🔄 Гарантия отката" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource SuccessBrush}" />
                                        <TextBlock Margin="0,4,0,0" Text="Исходные параметры сохраняются перед изменениями. Мгновенный сброс в один клик." Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="⚡ Прямой контроль" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource AccentBrush}" />
                                        <TextBlock Margin="0,4,0,0" Text="Таймер ОС 0.5 мс, MSI-прерывания и параметры ядра применяются напрямую без фоновых служб." Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="4" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="🔒 Совместимость" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource InfoBrush}" />
                                        <TextBlock Margin="0,4,0,0" Text="Полная поддержка Windows 10, 11 (23H2/24H2) и AtlasOS без повреждения системных обновлений." Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Quick Start Modes Grid (3 Columns) -->
                    <TextBlock Margin="2,16,0,10"
                               Text="ВЫБЕРИТЕ РЕЖИМ НАЧАЛА РАБОТЫ"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="10"
                               FontWeight="Bold" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Card 1: Simple / Express Mode -->
                        <Border Grid.Column="0"
                                Margin="0,0,7,0"
                                Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="18,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="34" Height="34" Background="{StaticResource ElevatedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                                            <TextBlock Text="🎮" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Базовый режим" FontSize="14" FontWeight="Bold" />
                                            <TextBlock Text="Экспресс-настройка" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Margin="0,12" Height="1" Background="{StaticResource BorderBrush}" />
                                </StackPanel>

                                <TextBlock Grid.Row="1"
                                           Text="Простой интерфейс с 10 проверенными переключателями для гейминга, плавности мыши, ядра и приватности."
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap" />

                                <Button Grid.Row="2"
                                        Margin="0,16,0,0"
                                        Padding="14,10"
                                        Style="{StaticResource PrimaryButton}"
                                        Command="{Binding NavigateFromWelcomeCommand}"
                                        CommandParameter="simple"
                                        Content="🚀 Запустить Базовый"
                                        HorizontalAlignment="Stretch" />
                            </Grid>
                        </Border>

                        <!-- Card 2: Pro Mode -->
                        <Border Grid.Column="1"
                                Margin="4,0,4,0"
                                Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="18,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="34" Height="34" Background="{StaticResource ElevatedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                                            <TextBlock Text="🛠️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Продвинутый Pro" FontSize="14" FontWeight="Bold" />
                                            <TextBlock Text="Полный контроль" Foreground="{StaticResource InfoBrush}" FontSize="10" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Margin="0,12" Height="1" Background="{StaticResource BorderBrush}" />
                                </StackPanel>

                                <TextBlock Grid.Row="1"
                                           Text="9 специализированных вкладок: реестр, службы с графом зависимостей, парковка ядер, прерывания MSI, таймер и ReTrim."
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap" />

                                <Button Grid.Row="2"
                                        Margin="0,16,0,0"
                                        Padding="14,10"
                                        Style="{StaticResource BaseButton}"
                                        Command="{Binding NavigateFromWelcomeCommand}"
                                        CommandParameter="pro"
                                        Content="🛠️ Открыть режим Pro"
                                        HorizontalAlignment="Stretch" />
                            </Grid>
                        </Border>

                        <!-- Card 3: Monitoring -->
                        <Border Grid.Column="2"
                                Margin="7,0,0,0"
                                Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="18,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="34" Height="34" Background="{StaticResource AccentDarkBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="8">
                                            <TextBlock Text="⚡" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Мониторинг" FontSize="14" FontWeight="Bold" />
                                            <TextBlock Text="Датчики и задержки" Foreground="{StaticResource SuccessBrush}" FontSize="10" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Margin="0,12" Height="1" Background="{StaticResource BorderBrush}" />
                                </StackPanel>

                                <TextBlock Grid.Row="1"
                                           Text="Аппаратный монитор в реальном времени: нагрузка ядер CPU, видеопамять GPU, таймер ОС, задержки DPC и сеть."
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap" />

                                <Button Grid.Row="2"
                                        Margin="0,16,0,0"
                                        Padding="14,10"
                                        Style="{StaticResource BaseButton}"
                                        Command="{Binding NavigateFromWelcomeCommand}"
                                        CommandParameter="monitoring"
                                        Content="📊 Открыть мониторинг"
                                        HorizontalAlignment="Stretch" />
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- AURUM SIMPLE MODE VIEW -->
            <Grid Grid.Row="1" Visibility="{Binding IsSimpleModeVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Filter Category Bar & Search -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Orientation="Horizontal">
                        <Button Margin="0,0,6,0" Padding="12,6" FontSize="11" Style="{StaticResource BaseButton}" Command="{Binding SetSimpleCategoryCommand}" CommandParameter="all" Content="Все опции" />
                        <Button Margin="0,0,6,0" Padding="12,6" FontSize="11" Style="{StaticResource BaseButton}" Command="{Binding SetSimpleCategoryCommand}" CommandParameter="gaming" Content="🎮 Гейминг и задержки" />
                        <Button Margin="0,0,6,0" Padding="12,6" FontSize="11" Style="{StaticResource BaseButton}" Command="{Binding SetSimpleCategoryCommand}" CommandParameter="system" Content="⚡ Система и ядро" />
                        <Button Margin="0,0,6,0" Padding="12,6" FontSize="11" Style="{StaticResource BaseButton}" Command="{Binding SetSimpleCategoryCommand}" CommandParameter="privacy" Content="🛡️ Приватность" />
                    </StackPanel>

                    <TextBox Grid.Column="1" Width="220" Padding="10,6" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" Foreground="{StaticResource TextBrush}" Text="{Binding SimpleSearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Поиск по названию или описанию" />
                </Grid>

                <!-- Cards ScrollView -->
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding FilteredSimpleFeatures}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,6" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Margin="0,0,18,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Icon}" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                
                                                <!-- Category Badge -->
                                                <Border Margin="8,0,0,0" Padding="6,1" Background="{StaticResource ElevatedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding CategoryLabel}" Foreground="{StaticResource AccentBrush}" FontSize="9" FontWeight="Bold" />
                                                </Border>
                                            </StackPanel>
                                            
                                            <TextBlock Margin="0,4,0,6" Text="{Binding Description}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" />

                                            <!-- Badges Row -->
                                            <ItemsControl ItemsSource="{Binding Badges}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,0,5,0" Padding="6,2" Background="{StaticResource ElevatedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                                                            <TextBlock Text="{Binding}" Foreground="{StaticResource MutedBrush}" FontSize="9" FontWeight="SemiBold" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <!-- ToggleSwitch on the Right -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <CheckBox Style="{StaticResource ToggleSwitch}"
                                                      IsChecked="{Binding IsToggleChecked, Mode=TwoWay}"
                                                      IsEnabled="{Binding CanToggle}">
                                                <TextBlock Text="{Binding StatusLabel}"
                                                           Foreground="{StaticResource SecondaryTextBrush}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Width="130" />
                                            </CheckBox>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- PRO MODE FULL TAB CONTROL -->
            <Grid Grid.Row="1" Visibility="{Binding IsProModeVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Pro Quick Summary Ribbon -->
                <Border Margin="0,0,0,10" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,7">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Padding="6,2" Background="{StaticResource ElevatedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,10,0">
                                <TextBlock Text="⚡ PRO РЕЖИМ" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" />
                            </Border>
                            <TextBlock Text="Твики: " Foreground="{StaticResource MutedBrush}" FontSize="11" />
                            <TextBlock Text="{Binding AppliedTweaksCount}" Foreground="{StaticResource SuccessBrush}" FontSize="11" FontWeight="Bold" />
                            <TextBlock Text="{Binding TotalTweaksCount, StringFormat='/{0}'}" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                            <TextBlock Text="  •  Дрейф: " Foreground="{StaticResource MutedBrush}" FontSize="11" />
                            <TextBlock Text="{Binding DriftedTweakCount}" FontSize="11" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DriftedTweakCount}" Value="0">
                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="  •  Таймер: " Foreground="{StaticResource MutedBrush}" FontSize="11" />
                            <TextBlock Text="{Binding Timer.CurrentResolutionLabel}" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock Text="  •  План питания: " Foreground="{StaticResource MutedBrush}" FontSize="11" />
                            <TextBlock Text="{Binding Monitoring.PowerPlanName}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" FontWeight="SemiBold" />
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button Padding="8,4" FontSize="10" Style="{StaticResource BaseButton}" Command="{Binding RefreshAllCommand}" Content="🔄 Синхронизировать всё" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TabControl Grid.Row="1"
                            SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
                    <TabItem Header="⚡ Твики">
                        <Grid Margin="0,8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            
                            <!-- Top Action and Summary Bar -->
                            <Grid Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="КОНТРОЛЬ И ОПТИМИЗАЦИЯ"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="10"
                                               FontWeight="Bold" />
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <TextBlock Text="{Binding TweakHealthLabel}" FontSize="12">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DriftedTweakCount}" Value="0">
                                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="  •  " Foreground="{StaticResource BorderBrush}" FontSize="12" />
                                        <TextBlock Text="{Binding AppliedTweaksCount, StringFormat=Активно: {0}}" Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding TotalTweaksCount, StringFormat=/{0}}" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                    <Button Padding="9,6"
                                            Margin="0,0,6,0"
                                            Style="{StaticResource BaseButton}"
                                            Command="{Binding SelectAllTweaksCommand}"
                                            Content="⚡ Выбрать все" />
                                    <Button Padding="9,6"
                                            Margin="0,0,6,0"
                                            Style="{StaticResource BaseButton}"
                                            Command="{Binding DeselectAllTweaksCommand}"
                                            Content="Снять выбор" />
                                    <Button Padding="11,6"
                                            Margin="0,0,6,0"
                                            Style="{StaticResource SecondaryButton}"
                                            Command="{Binding ApplySelectedCommand}"
                                            Content="✓ Применить" />
                                    <Button Padding="10,6"
                                            Style="{StaticResource BaseButton}"
                                            Command="{Binding RefreshAllCommand}"
                                            Content="🔄 Обновить" />
                                </StackPanel>
                            </Grid>

                            <!-- Search and Category Filter Pills -->
                            <Border Grid.Row="1" Margin="0,0,0,10" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    
                                    <!-- Search Box -->
                                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="🔍" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding TweakSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="Transparent"
                                                     Foreground="{StaticResource TextBrush}"
                                                     BorderThickness="0"
                                                     FontSize="12"
                                                     VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>

                                    <!-- Filter Pills Ribbon -->
                                    <ScrollViewer Grid.Row="1" Margin="0,8,0,0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Margin="0,0,6,0" Padding="10,4" Content="Все твики" Command="{Binding SetTweakCategoryFilterCommand}" CommandParameter="all" Style="{StaticResource BaseButton}" FontSize="10" />
                                            <Button Margin="0,0,6,0" Padding="10,4" Content="🛡️ Безопасные" Command="{Binding SetTweakCategoryFilterCommand}" CommandParameter="safe" Style="{StaticResource BaseButton}" FontSize="10" />
                                            <Button Margin="0,0,6,0" Padding="10,4" Content="🎮 Игры &amp; FPS" Command="{Binding SetTweakCategoryFilterCommand}" CommandParameter="gaming" Style="{StaticResource BaseButton}" FontSize="10" />
                                            <Button Margin="0,0,6,0" Padding="10,4" Content="🔒 Приватность" Command="{Binding SetTweakCategoryFilterCommand}" CommandParameter="privacy" Style="{StaticResource BaseButton}" FontSize="10" />
                                            <Button Margin="0,0,6,0" Padding="10,4" Content="⚡ Ядро &amp; Память" Command="{Binding SetTweakCategoryFilterCommand}" CommandParameter="kernel" Style="{StaticResource BaseButton}" FontSize="10" />
                                            <Button Margin="0,0,6,0" Padding="10,4" Content="⚠️ Изменённые (Дрейф)" Command="{Binding SetTweakCategoryFilterCommand}" CommandParameter="modified" Style="{StaticResource BaseButton}" FontSize="10" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <!-- Tweaks List -->
                            <ListBox Grid.Row="2"
                                     ItemsSource="{Binding FilteredTweaks}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     VirtualizingStackPanel.IsVirtualizing="True"
                                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,0,0,8" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Focusable" Value="False" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource CardBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="14,10">
                                            <StackPanel>
                                                <!-- Main Card Row (Compact) -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                              VerticalAlignment="Center"
                                                              Margin="0,0,4,0" />
                                                              
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,16,0">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <!-- Category Pill -->
                                                            <Border Padding="5,1" Background="{StaticResource ElevatedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                                                                <TextBlock Text="{Binding Category}" Foreground="{StaticResource AccentBrush}" FontSize="9" FontWeight="Bold" />
                                                            </Border>
                                                            
                                                            <!-- Risk Badge -->
                                                            <Border Margin="5,0,0,0" Padding="5,1" Background="{StaticResource ElevatedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                                                                <TextBlock Text="{Binding RiskLabel}" FontSize="9" FontWeight="Bold">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding RiskLabel}" Value="НУЖНО ВНИМАНИЕ"><Setter Property="Foreground" Value="{StaticResource WarningBrush}" /></DataTrigger>
                                                                                <DataTrigger Binding="{Binding RiskLabel}" Value="ВЫСОКИЙ РИСК"><Setter Property="Foreground" Value="{StaticResource ErrorBrush}" /></DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Border>
                                                            
                                                            <!-- Restart icon if required -->
                                                            <TextBlock Margin="6,0,0,0" Text="🔄 Рестарт" ToolTip="{Binding RestartLabel}" Foreground="{StaticResource CodeMutedBrush}" FontSize="9" Visibility="{Binding RequiresRestart, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalAlignment="Center" />
                                                        </StackPanel>

                                                        <TextBlock Margin="0,4,0,0" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" />
                                                        <TextBlock Margin="0,2,0,0" Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <!-- Right Controls: ToggleSwitch + Details Expand Button -->
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <CheckBox Style="{StaticResource ToggleSwitch}"
                                                                  IsChecked="{Binding IsToggleChecked, Mode=TwoWay}"
                                                                  IsEnabled="{Binding CanToggle}">
                                                            <TextBlock Text="{Binding StateLabel}"
                                                                       FontSize="10"
                                                                       FontWeight="SemiBold"
                                                                       Width="125">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding State}" Value="Applied"><Setter Property="Foreground" Value="{StaticResource SuccessBrush}" /></DataTrigger>
                                                                            <DataTrigger Binding="{Binding State}" Value="Drifted"><Setter Property="Foreground" Value="{StaticResource WarningBrush}" /></DataTrigger>
                                                                            <DataTrigger Binding="{Binding State}" Value="AlreadyConfigured"><Setter Property="Foreground" Value="{StaticResource InfoBrush}" /></DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </CheckBox>

                                                        <!-- Expand / Collapse Details Chevron Button -->
                                                        <Button Margin="10,0,0,0"
                                                                Padding="6,3"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Command="{Binding ToggleExpandCommand}"
                                                                Cursor="Hand"
                                                                ToolTip="Показать / скрыть технические подробности">
                                                            <TextBlock FontSize="11">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="▼ Детали" />
                                                                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                                <Setter Property="Text" Value="▲ Скрыть" />
                                                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Collapsible Details Section -->
                                                <Border Margin="0,10,0,0"
                                                        Padding="12,10"
                                                        Background="{StaticResource PanelBrush}"
                                                        BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            
                                                            <StackPanel Margin="0,0,10,0">
                                                                <TextBlock Text="СИСТЕМНЫЙ ЭФФЕКТ" Foreground="{StaticResource AccentBrush}" FontSize="9" FontWeight="Bold" />
                                                                <TextBlock Margin="0,2,0,6" Text="{Binding Impact}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" />
                                                                
                                                                <TextBlock Text="ПУТЬ В РЕЕСТРЕ" Foreground="{StaticResource MutedBrush}" FontSize="9" FontWeight="Bold" />
                                                                <Border Margin="0,3,0,0" Background="{StaticResource ElevatedBrush}" Padding="8,4" CornerRadius="4">
                                                                    <TextBlock Text="{Binding RegistryPaths}" Foreground="{StaticResource CodeMutedBrush}" FontFamily="{StaticResource CodeFontFamily}" FontSize="9" TextWrapping="Wrap" />
                                                                </Border>
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <Button Margin="0,0,0,4"
                                                                        Padding="10,4"
                                                                        Style="{StaticResource SecondaryButton}"
                                                                        Command="{Binding RepairCommand}"
                                                                        Visibility="{Binding CanRepair, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                        Content="⚠️ Исправить дрейф" />
                                                                <Button Padding="10,4"
                                                                        Style="{StaticResource SecondaryButton}"
                                                                        Command="{Binding RevertCommand}"
                                                                        Visibility="{Binding CanRevert, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                        Content="↺ Откатить твик" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </TabItem>

                <TabItem Header="⚙️ Службы">
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Top Toolbar with Actions & Category Filters -->
                        <Border Grid.Row="0" Margin="0,0,0,10" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Top Row: Title, Summary, and Master Buttons -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="УПРАВЛЕНИЕ И АНАЛИЗ СЛУЖБ WINDOWS" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" />
                                        <TextBlock Margin="0,3,0,0" Text="{Binding Services.Summary}" Foreground="{StaticResource AccentBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Margin="0,0,8,0"
                                                Padding="12,7"
                                                Style="{StaticResource PrimaryButton}"
                                                Command="{Binding Services.OptimizeAllServicesCommand}"
                                                Content="⚡ Оптимизировать все службы"
                                                ToolTip="Отключить все безопасные фоновые службы телеметрии и диагностики с сохранением исходного состояния для отката" />
                                        <Button Margin="0,0,8,0"
                                                Padding="12,7"
                                                Style="{StaticResource BaseButton}"
                                                Command="{Binding Services.RevertAllServicesCommand}"
                                                Content="🔄 Сбросить все"
                                                ToolTip="Восстановить исходное состояние всех служб, отключённых через Aurum" />
                                        <Button Padding="12,7"
                                                Style="{StaticResource BaseButton}"
                                                Command="{Binding Services.RefreshCommand}"
                                                Content="🔄 Обновить" />
                                    </StackPanel>
                                </Grid>

                                <!-- Bottom Row: Category Filter Pills and Search Box -->
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Margin="0,0,5,0" Padding="10,5" FontSize="11" Style="{StaticResource BaseButton}" Command="{Binding Services.SetCategoryCommand}" CommandParameter="all" Content="Все службы" />
                                        <Button Margin="0,0,5,0" Padding="10,5" FontSize="11" Style="{StaticResource BaseButton}" Command="{Binding Services.SetCategoryCommand}" CommandParameter="telemetry" Content="📊 Телеметрия" />
                                        <Button Margin="0,0,5,0" Padding="10,5" FontSize="11" Style="{StaticResource BaseButton}" Command="{Binding Services.SetCategoryCommand}" CommandParameter="xbox" Content="🎮 Xbox Live" />
                                        <Button Margin="0,0,5,0" Padding="10,5" FontSize="11" Style="{StaticResource BaseButton}" Command="{Binding Services.SetCategoryCommand}" CommandParameter="print" Content="🖨️ Печать" />
                                        <Button Margin="0,0,5,0" Padding="10,5" FontSize="11" Style="{StaticResource BaseButton}" Command="{Binding Services.SetCategoryCommand}" CommandParameter="maps" Content="🗺️ Геолокация &amp; Карты" />
                                        <Button Margin="0,0,5,0" Padding="10,5" FontSize="11" Style="{StaticResource BaseButton}" Command="{Binding Services.SetCategoryCommand}" CommandParameter="touch" Content="✏️ Сенсор &amp; Перо" />
                                    </StackPanel>

                                    <!-- Search Box -->
                                    <Border Grid.Column="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4" Width="220">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="🔍" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding Services.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     Foreground="{StaticResource TextBrush}"
                                                     FontSize="11"
                                                     VerticalAlignment="Center"
                                                     ToolTip="Поиск по имени службы, отображаемому названию или категории" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Master-Detail Body Grid -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.15*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="0.85*" />
                            </Grid.ColumnDefinitions>

                            <!-- Left Master Column: Scrollable List of All Services with Inline Toggles -->
                            <ListBox Grid.Column="0"
                                     ItemsSource="{Binding Services.Services}"
                                     SelectedItem="{Binding Services.SelectedService, Mode=TwoWay}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,0,0,6" />
                                        <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource CardBrush}" BorderThickness="1" CornerRadius="8" Padding="13,10" Cursor="Hand">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                            <Setter Property="Background" Value="{StaticResource ElevatedBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,12,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        <Border Margin="8,0,0,0" Padding="5,1" Background="{StaticResource ElevatedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding CategoryLabel}" Foreground="{StaticResource AccentBrush}" FontSize="9" FontWeight="Bold" />
                                                        </Border>
                                                    </StackPanel>

                                                    <TextBlock Margin="0,3,0,0" Text="{Binding Name}" Foreground="{StaticResource CodeMutedBrush}" FontFamily="{StaticResource CodeFontFamily}" FontSize="9" />
                                                    <TextBlock Margin="0,4,0,0" Text="{Binding Capability}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" TextTrimming="CharacterEllipsis" />

                                                    <!-- Status Pills Row -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                        <Border Margin="0,0,6,0" Padding="5,2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                                                            <TextBlock Text="{Binding StateLabel}" FontSize="9" FontWeight="Bold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding StateLabel}" Value="ОСТАНОВЛЕНА">
                                                                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                        <Border Margin="0,0,6,0" Padding="5,2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                                                            <TextBlock Text="{Binding StartModeLabel}" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                                        </Border>
                                                        <Border Padding="5,2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                                                            <TextBlock Text="{Binding TrackingStateLabel}" Foreground="{StaticResource WarningBrush}" FontSize="8" FontWeight="Bold" />
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Inline Toggle Switch on each Card -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                    <CheckBox Style="{StaticResource ToggleSwitch}"
                                                              IsChecked="{Binding IsServiceDisabled, Mode=TwoWay}"
                                                              ToolTip="Переключить тип запуска службы (Отключить / Восстановить)">
                                                        <TextBlock Text="{Binding StateLabel}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" FontWeight="SemiBold" Width="95" />
                                                    </CheckBox>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Right Details Column: Fixed / Stationary Details Card -->
                            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18,15">
                                        <StackPanel>
                                            <Grid>
                                                <StackPanel Margin="0,0,10,0">
                                                    <TextBlock Text="ВЫБРАННАЯ СЛУЖБА" Foreground="{StaticResource MutedBrush}" FontSize="9" FontWeight="Bold" />
                                                    <TextBlock Margin="0,5,0,0" Text="{Binding Services.SelectedService.DisplayName}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Margin="0,3,0,0" Text="{Binding Services.SelectedService.Name}" Foreground="{StaticResource CodeMutedBrush}" FontFamily="{StaticResource CodeFontFamily}" FontSize="10" />
                                                </StackPanel>
                                                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Top" Text="{Binding Services.SelectedService.SafetyLabel}" Foreground="{StaticResource WarningBrush}" FontSize="9" FontWeight="Bold" />
                                            </Grid>

                                            <TextBlock Margin="0,12,0,0" Text="{Binding Services.SelectedService.Description}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" />

                                            <Border Margin="0,12" Height="1" Background="{StaticResource BorderBrush}" />

                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Состояние" Foreground="{StaticResource MutedBrush}" /><TextBlock Grid.Column="1" HorizontalAlignment="Right" Text="{Binding Services.SelectedService.StateLabel}" FontWeight="SemiBold" /></Grid>
                                            <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Тип запуска" Foreground="{StaticResource MutedBrush}" /><TextBlock Grid.Column="1" HorizontalAlignment="Right" Text="{Binding Services.SelectedService.StartModeLabel}" FontWeight="SemiBold" /></Grid>
                                            <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Процесс" Foreground="{StaticResource MutedBrush}" /><TextBlock Grid.Column="1" HorizontalAlignment="Right" Text="{Binding Services.SelectedService.ProcessLabel}" FontWeight="SemiBold" /></Grid>

                                            <!-- Impact & Guidance -->
                                            <Border Margin="0,12,0,0" Background="{StaticResource AccentDarkBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Services.SelectedService.Capability}" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="11" />
                                                    <TextBlock Margin="0,4,0,0" Text="{Binding Services.SelectedService.Guidance}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Dependencies Graph -->
                                            <Border Margin="0,10,0,0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                                <StackPanel>
                                                    <TextBlock Text="ГРАФ ВЛИЯНИЯ" Foreground="{StaticResource MutedBrush}" FontSize="9" FontWeight="Bold" />
                                                    <TextBlock Margin="0,8,0,0" Text="Зависит от:" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="10" />
                                                    <TextBlock Margin="0,2,0,0" Text="{Binding Services.SelectedService.DependenciesLabel}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" TextWrapping="Wrap" />
                                                    <TextBlock Margin="0,8,0,0" Text="От неё зависят:" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="10" />
                                                    <TextBlock Margin="0,2,0,0" Text="{Binding Services.SelectedService.DependantsLabel}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Actions Buttons -->
                                            <StackPanel Margin="0,14,0,0">
                                                <Button Margin="0,0,0,6" Padding="12,8" Style="{StaticResource BaseButton}" Command="{Binding Services.SelectedService.DisableCommand}" Content="Отключить службу" IsEnabled="{Binding Services.SelectedService.CanDisable}" />
                                                <Button Margin="0,0,0,6" Padding="12,8" Style="{StaticResource BaseButton}" Command="{Binding Services.SelectedService.RevertCommand}" Content="Восстановить исходное" IsEnabled="{Binding Services.SelectedService.CanRevert}" />
                                                <Button Padding="12,8" Style="{StaticResource BaseButton}" Command="{Binding Services.SelectedService.RepairCommand}" Content="Исправить состояние" IsEnabled="{Binding Services.SelectedService.CanRepair}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="⏱️ Процессор &amp; Таймер">
                    <ScrollViewer Margin="0,12,0,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Master Batch Action Bar for Processor & Timer -->
                            <Border Margin="0,0,0,12" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="14,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="КОМПЛЕКСНАЯ ОПТИМИЗАЦИЯ ПРОЦЕССОРА И ЗАДЕРЖЕК" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" />
                                        <TextBlock Margin="0,3,0,0" Text="Таймер 0.500 мс + MSI High priority (GPU &amp; Сеть) + 100% Core Parking без парковки ядер." Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Margin="0,0,8,0" Padding="14,8" Style="{StaticResource PrimaryButton}" Command="{Binding ApplyAllProcessorTimerGamingCommand}" Content="⚡ Применить все игровые параметры" />
                                        <Button Padding="14,8" Style="{StaticResource BaseButton}" Command="{Binding RevertProcessorTimerCommand}" Content="🔄 Сбросить к стандартным" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- SYSTEM TIMER RESOLUTION CARD -->
                            <Border Margin="0,0,0,14" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18,15">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="СИСТЕМНЫЙ ТАЙМЕР WINDOWS (TIMER RESOLUTION)" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" />
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Timer.CurrentResolutionLabel}" Foreground="{StaticResource AccentBrush}" FontSize="20" FontWeight="Bold" />
                                                <TextBlock Margin="10,0,0,0" Text="{Binding Timer.FrequencyLabel}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Margin="0,0,6,0" Padding="12,7" Style="{StaticResource BaseButton}" Command="{Binding Timer.Set05MsCommand}" Content="⚡ 0.500 мс (eSports)" ToolTip="2000 Гц - максимальная точность для игр" />
                                            <Button Margin="0,0,6,0" Padding="12,7" Style="{StaticResource BaseButton}" Command="{Binding Timer.Set10MsCommand}" Content="1.000 мс" ToolTip="1000 Гц - баланс точности и потребления" />
                                            <Button Padding="12,7" Style="{StaticResource BaseButton}" Command="{Binding Timer.SetDefaultCommand}" Content="По умолчанию" ToolTip="Стандартный таймер Windows (~15.6 мс)" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid Grid.Row="1" Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Высокочастотный таймер снижает задержку ввода, устраняет микростаттеры и синхронизирует игровой цикл с частотой опроса мыши (1000-8000 Гц)." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        <CheckBox Grid.Column="1"
                                                  Margin="16,0,0,0"
                                                  Style="{StaticResource ToggleSwitch}"
                                                  IsChecked="{Binding Timer.IsToggleGlobalPolicy, Mode=TwoWay}"
                                                  ToolTip="Переключает параметр GlobalTimerResolutionRequests в реестре ядра Windows">
                                            <TextBlock Text="Глобальный запрос (Win11)" FontWeight="SemiBold" FontSize="11" />
                                        </CheckBox>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Grid Margin="0,0,0,13">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="CORE PARKING · РАСШИРЕННЫЙ РЕЖИМ" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" />
                                    <TextBlock Margin="0,4,0,0" Text="{Binding CoreParking.Summary}" Foreground="{StaticResource AccentBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Margin="0,0,8,0" Padding="12,7" Style="{StaticResource BaseButton}" Command="{Binding CoreParking.RefreshCommand}" Content="Обновить" />
                                    <Button Margin="0,0,8,0" Padding="12,7" Style="{StaticResource BaseButton}" Command="{Binding CoreParking.RevertCommand}" Content="Вернуть исходный" />
                                    <Button Margin="0,0,8,0" Padding="12,7" Style="{StaticResource BaseButton}" Command="{Binding CoreParking.RepairCommand}" Content="Восстановить" />
                                    <Button Padding="12,7" Style="{StaticResource PrimaryButton}" Command="{Binding CoreParking.ApplyCommand}" Content="Создать план Aurum" />
                                </StackPanel>
                            </Grid>

                            <UniformGrid Columns="3" Margin="0,0,0,13">
                                <Border Margin="0,0,6,0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="15,12">
                                    <StackPanel><TextBlock Text="АКТИВНЫЙ ПЛАН" Foreground="{StaticResource MutedBrush}" FontSize="9" FontWeight="Bold" /><TextBlock Margin="0,6,0,0" Text="{Binding CoreParking.ActivePlanName}" TextTrimming="CharacterEllipsis" FontSize="15" FontWeight="SemiBold" /></StackPanel>
                                </Border>
                                <Border Margin="3,0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="15,12">
                                    <StackPanel><TextBlock Text="ИСХОДНЫЙ ПЛАН" Foreground="{StaticResource MutedBrush}" FontSize="9" FontWeight="Bold" /><TextBlock Margin="0,6,0,0" Text="{Binding CoreParking.OriginalPlanLabel}" TextTrimming="CharacterEllipsis" FontSize="15" FontWeight="SemiBold" /></StackPanel>
                                </Border>
                                <Border Margin="6,0,0,0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="15,12">
                                    <StackPanel><TextBlock Text="СОСТОЯНИЕ" Foreground="{StaticResource MutedBrush}" FontSize="9" FontWeight="Bold" /><TextBlock Margin="0,6,0,0" Text="{Binding CoreParking.StateLabel}" Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="Bold" /></StackPanel>
                                </Border>
                            </UniformGrid>

                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18,15">
                                    <StackPanel>
                                        <TextBlock Text="ОТ СЕТИ · AC" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" />
                                        <Grid Margin="0,14,0,0"><TextBlock Text="Минимум активных процессоров" /><TextBlock HorizontalAlignment="Right" Text="{Binding CoreParking.MinimumAcLabel}" FontSize="15" FontWeight="SemiBold" /></Grid>
                                        <Slider Margin="0,8,0,0" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding CoreParking.MinimumAc, Mode=TwoWay}" />
                                        <TextBlock Margin="0,8,0,0" Text="Нижняя граница логических процессоров, которые Windows держит распаркованными." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" />
                                        <Border Margin="0,13" Height="1" Background="{StaticResource BorderBrush}" />
                                        <Grid><TextBlock Text="Максимум активных процессоров" /><TextBlock HorizontalAlignment="Right" Text="{Binding CoreParking.MaximumAcLabel}" FontSize="15" FontWeight="SemiBold" /></Grid>
                                        <Slider Margin="0,8,0,0" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding CoreParking.MaximumAc, Mode=TwoWay}" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18,15">
                                    <StackPanel>
                                        <TextBlock Text="ОТ БАТАРЕИ · DC" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" />
                                        <Grid Margin="0,14,0,0"><TextBlock Text="Минимум активных процессоров" /><TextBlock HorizontalAlignment="Right" Text="{Binding CoreParking.MinimumDcLabel}" FontSize="15" FontWeight="SemiBold" /></Grid>
                                        <Slider Margin="0,8,0,0" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding CoreParking.MinimumDc, Mode=TwoWay}" />
                                        <TextBlock Margin="0,8,0,0" Text="DC применяется на устройствах с батареей; на настольном ПК значение сохраняется, но обычно не используется." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" />
                                        <Border Margin="0,13" Height="1" Background="{StaticResource BorderBrush}" />
                                        <Grid><TextBlock Text="Максимум активных процессоров" /><TextBlock HorizontalAlignment="Right" Text="{Binding CoreParking.MaximumDcLabel}" FontSize="15" FontWeight="SemiBold" /></Grid>
                                        <Slider Margin="0,8,0,0" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding CoreParking.MaximumDc, Mode=TwoWay}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid Margin="0,13,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Border Background="{StaticResource AccentDarkBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="14,11">
                                    <StackPanel>
                                        <TextBlock Text="{Binding CoreParking.ValidationLabel}" Foreground="{StaticResource SecondaryTextBrush}" FontWeight="SemiBold" />
                                        <TextBlock Margin="0,5,0,0" Text="100% в поле минимума отключает парковку. Это не гарантирует рост FPS и может увеличить энергопотребление, нагрев и шум." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Button Grid.Column="1" Margin="12,0,0,0" Padding="14,9" VerticalAlignment="Stretch" Style="{StaticResource BaseButton}" Command="{Binding CoreParking.DisableParkingCommand}" Content="Выставить 100%" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="🎮 Прерывания MSI">
                    <ScrollViewer Margin="0,12,0,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Top Header & Actions -->
                            <Grid Margin="0,0,0,13">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="АППАРАТНЫЕ ПРЕРЫВАНИЯ (MSI MODE)" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" />
                                    <TextBlock Margin="0,4,0,0" Text="{Binding Msi.Summary}" Foreground="{StaticResource AccentBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBox Width="180" Margin="0,0,8,0" Padding="10,7" Text="{Binding Msi.SearchText, UpdateSourceTrigger=PropertyChanged}" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" Foreground="{StaticResource TextBrush}" ToolTip="Поиск устройства по имени или расположению" />
                                    <Button Margin="0,0,8,0" Padding="11,7" Style="{StaticResource BaseButton}" Command="{Binding Msi.RefreshCommand}" Content="Обновить" />
                                    <Button Margin="0,0,8,0" Padding="11,7" Style="{StaticResource BaseButton}" Command="{Binding Msi.RevertCommand}" Content="Вернуть исходные" />
                                    <Button Padding="13,7" Style="{StaticResource PrimaryButton}" Command="{Binding Msi.ApplyGamingPresetCommand}" Content="⚡ Оптимизировать для игр" />
                                </StackPanel>
                            </Grid>

                            <!-- Category Filter Bar -->
                            <Border Margin="0,0,0,14" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Margin="2,0" Padding="10,5" Style="{StaticResource BaseButton}" Command="{Binding Msi.SetFilterCommand}" CommandParameter="all" Content="Все устройства" />
                                            <Button Margin="2,0" Padding="10,5" Style="{StaticResource BaseButton}" Command="{Binding Msi.SetFilterCommand}" CommandParameter="gpu" Content="🎮 Видеокарта (GPU)" />
                                            <Button Margin="2,0" Padding="10,5" Style="{StaticResource BaseButton}" Command="{Binding Msi.SetFilterCommand}" CommandParameter="net" Content="🌐 Сеть (LAN/Wi-Fi)" />
                                            <Button Margin="2,0" Padding="10,5" Style="{StaticResource BaseButton}" Command="{Binding Msi.SetFilterCommand}" CommandParameter="audio" Content="🔊 Звук (Audio)" />
                                            <Button Margin="2,0" Padding="10,5" Style="{StaticResource BaseButton}" Command="{Binding Msi.SetFilterCommand}" CommandParameter="usb" Content="🔌 USB контроллеры" />
                                            <Button Margin="2,0" Padding="10,5" Style="{StaticResource BaseButton}" Command="{Binding Msi.SetFilterCommand}" CommandParameter="storage" Content="💾 Дисковые контроллеры" />
                                        </StackPanel>
                                    </ScrollViewer>
                                    <CheckBox Grid.Column="1"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              Margin="12,0,4,0"
                                              Style="{StaticResource ToggleSwitch}"
                                              IsChecked="{Binding Msi.ShowOnlyKeyDevices, Mode=TwoWay}">
                                        <TextBlock Text="Скрыть системные мосты" FontSize="10" FontWeight="SemiBold" />
                                    </CheckBox>
                                </Grid>
                            </Border>

                            <!-- Devices List -->
                            <ItemsControl ItemsSource="{Binding Msi.FilteredDevices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,10" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18,14">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                
                                                <StackPanel Margin="0,0,20,0">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding CategoryIcon}" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                        <Border Margin="10,0,0,0" Padding="6,2" Background="{StaticResource ElevatedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding CategoryLabel}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="8" FontWeight="Bold" />
                                                        </Border>
                                                        <Border Margin="6,0,0,0" Padding="6,2" Background="{StaticResource ElevatedBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="4" VerticalAlignment="Center" Visibility="{Binding IsRecommendedDevice, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Text="⭐ КЛЮЧЕВОЕ УСТРОЙСТВО" Foreground="{StaticResource AccentBrush}" FontSize="8" FontWeight="Bold" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Margin="24,4,0,0" Text="{Binding LocationInfo}" Foreground="{StaticResource MutedBrush}" FontFamily="{StaticResource CodeFontFamily}" FontSize="10" />
                                                    <TextBlock Margin="24,3,0,0" Text="{Binding DeviceInstanceId}" Foreground="{StaticResource CodeMutedBrush}" FontFamily="{StaticResource CodeFontFamily}" FontSize="8" TextTrimming="CharacterEllipsis" Visibility="{Binding DataContext.IsProMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <!-- Priority Selector -->
                                                    <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                                                        <TextBlock Text="Приоритет прерываний" Foreground="{StaticResource MutedBrush}" FontSize="9" HorizontalAlignment="Right" />
                                                        <ComboBox Margin="0,3,0,0"
                                                                  ItemsSource="{Binding PriorityOptions}"
                                                                  SelectedItem="{Binding SelectedPriorityOption, Mode=TwoWay}"
                                                                  IsEnabled="{Binding CanEdit}"
                                                                  Width="180"
                                                                  Height="28"
                                                                  Background="{StaticResource PanelBrush}"
                                                                  Foreground="{StaticResource TextBrush}" />
                                                    </StackPanel>

                                                    <!-- MSI Mode ToggleSwitch -->
                                                    <CheckBox Style="{StaticResource ToggleSwitch}"
                                                              IsChecked="{Binding IsMsiSupported, Mode=TwoWay}"
                                                              IsEnabled="{Binding CanEdit}"
                                                              VerticalAlignment="Center"
                                                              Margin="0,8,0,0">
                                                        <TextBlock Text="Режим MSI" FontWeight="SemiBold" FontSize="11" />
                                                    </CheckBox>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Bottom Explanatory Card -->
                            <Border Margin="0,8,0,16" Background="{StaticResource AccentDarkBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="16,12">
                                <StackPanel>
                                    <TextBlock Text="О РЕЖИМЕ MSI (MESSAGE SIGNALED INTERRUPTS)" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" />
                                    <TextBlock Margin="0,5,0,0" Text="Режим MSI заменяет устаревшие общие линии прерываний (Line-based IRQ) прямой записью в память контроллера прерываний (APIC). Это устраняет очереди прерываний, снижает DPC Latency и микрофризы в соревновательных играх." Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="🔋 Питание">
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,13">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="ПЛАНЫ ЭЛЕКТРОПИТАНИЯ"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="10"
                                           FontWeight="Bold" />
                                <TextBlock Margin="0,4,0,0"
                                           MaxWidth="650"
                                           HorizontalAlignment="Left"
                                           Text="{Binding Power.Summary}"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal">
                                <Button Margin="0,0,8,0"
                                        Padding="12,7"
                                        Style="{StaticResource BaseButton}"
                                        Command="{Binding Power.RefreshCommand}"
                                        Content="🔄 Обновить" />
                                <Button Margin="0,0,8,0"
                                        Padding="12,7"
                                        Style="{StaticResource BaseButton}"
                                        Command="{Binding Power.RevertCommand}"
                                        Content="Вернуть исходный" />
                                <Button Margin="0,0,8,0"
                                        Padding="12,7"
                                        Style="{StaticResource BaseButton}"
                                        Command="{Binding Power.RepairCommand}"
                                        Content="Восстановить" />
                                <Button Padding="12,7"
                                        Style="{StaticResource PrimaryButton}"
                                        Command="{Binding Power.ApplyCommand}"
                                        Content="Активировать" />
                            </StackPanel>
                        </Grid>

                        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,13">
                            <Border Margin="0,0,6,0"
                                    Background="{StaticResource CardBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Padding="15,12">
                                <StackPanel>
                                    <TextBlock Text="АКТИВНЫЙ ПЛАН" Foreground="{StaticResource MutedBrush}" FontSize="9" FontWeight="Bold" />
                                    <TextBlock Margin="0,6,0,0" Text="{Binding Power.ActivePlanName}" TextTrimming="CharacterEllipsis" FontSize="15" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Margin="3,0"
                                    Background="{StaticResource CardBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Padding="15,12">
                                <StackPanel>
                                    <TextBlock Text="ТОЧКА ОТКАТА" Foreground="{StaticResource MutedBrush}" FontSize="9" FontWeight="Bold" />
                                    <TextBlock Margin="0,6,0,0" Text="{Binding Power.OriginalPlanLabel}" TextTrimming="CharacterEllipsis" FontSize="15" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Margin="6,0,0,0"
                                    Background="{StaticResource CardBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Padding="15,12">
                                <StackPanel>
                                    <TextBlock Text="СОСТОЯНИЕ AURUM" Foreground="{StaticResource MutedBrush}" FontSize="9" FontWeight="Bold" />
                                    <TextBlock Margin="0,6,0,0" Text="{Binding Power.StateLabel}" FontSize="12" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Power.State}" Value="Applied"><Setter Property="Foreground" Value="{StaticResource SuccessBrush}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding Power.State}" Value="Drifted"><Setter Property="Foreground" Value="{StaticResource WarningBrush}" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Выберите существующий план Windows. Aurum не изменяет его внутренние параметры."
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="11" />
                            <ListBox Grid.Row="1"
                                     Margin="0,10,0,10"
                                     ItemsSource="{Binding Power.Plans}"
                                     SelectedItem="{Binding Power.SelectedPlan, Mode=TwoWay}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,0,0,8" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Focusable" Value="True" />
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource CardBrush}"
                                                BorderThickness="1"
                                                CornerRadius="9"
                                                Padding="16,13">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                            <Setter Property="Background" Value="{StaticResource ElevatedBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                                                    <TextBlock Margin="0,5,0,0"
                                                               Text="{Binding Identifier}"
                                                               Foreground="{StaticResource CodeMutedBrush}"
                                                               FontFamily="{StaticResource CodeFontFamily}"
                                                               FontSize="9" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding RoleLabel}"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           FontSize="9"
                                                           FontWeight="Bold" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Border Grid.Row="2"
                                    Background="{StaticResource AccentDarkBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="13,10">
                                <TextBlock Text="Выбор применяется только после подтверждения. Первый активный план сохраняется и остаётся точкой отката даже после восстановления дрейфа."
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="10"
                                           TextWrapping="Wrap" />
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="🌐 Сеть">
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid Margin="0,0,0,13">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="СЕТЕВАЯ ДИАГНОСТИКА" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" />
                                <TextBlock Margin="0,4,0,0" Text="{Binding Network.Summary}" Foreground="{StaticResource AccentBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Margin="0,0,8,0" Padding="12,7" Style="{StaticResource PrimaryButton}" Command="{Binding Network.OptimizeAllNetworkCommand}" Content="⚡ Оптимизировать сеть" ToolTip="Установить Cloudflare DNS (1.1.1.1), настроить TCP Auto-Tuning Normal и сбросить кэш DNS" />
                                <Button Margin="0,0,8,0" Padding="12,7" Style="{StaticResource BaseButton}" Command="{Binding Network.RefreshCommand}" Content="Обновить" />
                                <Button Padding="12,7" Style="{StaticResource BaseButton}" Command="{Binding Network.ToggleAdvancedCommand}" Content="{Binding Network.AdvancedButtonLabel}" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1"
                                Margin="0,0,0,13"
                                Visibility="{Binding Network.IsSimpleVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Background="{StaticResource AccentDarkBrush}"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="1"
                                CornerRadius="11"
                                Padding="20,17">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="0.85*" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Проверить качество соединения" FontSize="19" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,6,0,0"
                                               Text="Aurum измерит задержку и потери пакетов к выбранному игровому серверу или шлюзу для выявления нестабильности канала."
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap" />
                                    <Grid Margin="0,13,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox AutomationProperties.Name="Адрес для быстрой проверки" Margin="0,0,8,0" Padding="11,8" Text="{Binding Network.ProbeTarget, UpdateSourceTrigger=PropertyChanged}" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" Foreground="{StaticResource TextBrush}" /><Button Grid.Column="1" Padding="14,8" Style="{StaticResource PrimaryButton}" Command="{Binding Network.ProbeCommand}" Content="Проверить сеть" /></Grid>
                                    <TextBlock Margin="0,11,0,0" Text="{Binding Network.ProbeSummary}" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,4,0,0" Text="{Binding Network.ProbeDetails}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" />
                                </StackPanel>
                                <Border Grid.Column="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="16,14">
                                    <StackPanel>
                                        <TextBlock Text="Что произойдёт" Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="Bold" />
                                        <TextBlock Margin="0,9,0,0" Text="1. Четыре коротких ICMP-запроса к целевому серверу." Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" TextWrapping="Wrap" />
                                        <TextBlock Margin="0,7,0,0" Text="2. Точный расчёт задержки и потерь пакетов." Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" TextWrapping="Wrap" />
                                        <TextBlock Margin="0,7,0,0" Text="3. Никакие сетевые параметры Windows не изменяются." Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" TextWrapping="Wrap" />
                                        <TextBlock Margin="0,10,0,0" Text="Диагностика полностью безопасна и работает в пассивном режиме измерения." Foreground="{StaticResource MutedBrush}" FontSize="9" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2"
                              Visibility="{Binding Network.IsAdvancedVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="0.4*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="0.6*" /></Grid.ColumnDefinitions>
                            <ListBox ItemsSource="{Binding Network.Adapters}" SelectedItem="{Binding Network.SelectedAdapter, Mode=TwoWay}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,0,8" /><Setter Property="AutomationProperties.Name" Value="{Binding Name}" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value></Setter></Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource CardBrush}" BorderThickness="1" CornerRadius="9" Padding="15,13">
                                            <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" /><Style.Triggers><DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" /><Setter Property="Background" Value="{StaticResource ElevatedBrush}" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                            <StackPanel>
                                                <Grid><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="15" FontWeight="SemiBold" /><TextBlock HorizontalAlignment="Right" Text="{Binding RoleLabel}" Foreground="{StaticResource AccentBrush}" FontSize="8" FontWeight="Bold" /></Grid>
                                                <TextBlock Margin="0,5,0,0" Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" />
                                                <Grid Margin="0,10,0,0"><TextBlock Text="{Binding AddressSummary}" Foreground="{StaticResource SecondaryTextBrush}" FontFamily="{StaticResource CodeFontFamily}" FontSize="10" /><TextBlock HorizontalAlignment="Right" Text="{Binding SpeedLabel}" Foreground="{StaticResource MutedBrush}" FontSize="10" /></Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18,15">
                                        <StackPanel>
                                            <Grid>
                                                <StackPanel><TextBlock Text="ВЫБРАННЫЙ АДАПТЕР" Foreground="{StaticResource MutedBrush}" FontSize="9" FontWeight="Bold" /><TextBlock Margin="0,5,0,0" Text="{Binding Network.SelectedAdapter.Name}" FontSize="19" FontWeight="SemiBold" /><TextBlock Margin="0,3,0,0" Text="{Binding Network.SelectedAdapter.Description}" Foreground="{StaticResource CodeMutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" /></StackPanel>
                                                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Top" Text="{Binding Network.SelectedAdapter.RoleLabel}" Foreground="{StaticResource AccentBrush}" FontSize="9" FontWeight="Bold" />
                                            </Grid>
                                            <Border Margin="0,12" Height="1" Background="{StaticResource BorderBrush}" />
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="105" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Состояние" Foreground="{StaticResource MutedBrush}" /><TextBlock Grid.Column="1" HorizontalAlignment="Right" Text="{Binding Network.SelectedAdapter.StatusLabel}" FontWeight="SemiBold" /></Grid>
                                            <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="105" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Тип / скорость" Foreground="{StaticResource MutedBrush}" /><TextBlock Grid.Column="1" HorizontalAlignment="Right"><Run Text="{Binding Network.SelectedAdapter.TypeLabel, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Network.SelectedAdapter.SpeedLabel, Mode=OneWay}" /></TextBlock></Grid>
                                            <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="105" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="MTU / MAC" Foreground="{StaticResource MutedBrush}" /><TextBlock Grid.Column="1" HorizontalAlignment="Right" FontFamily="{StaticResource CodeFontFamily}" FontSize="10"><Run Text="{Binding Network.SelectedAdapter.MtuLabel, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Network.SelectedAdapter.PhysicalAddressLabel, Mode=OneWay}" /></TextBlock></Grid>
                                            <TextBlock Margin="0,12,0,0" Text="IPv4" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" /><TextBlock Margin="0,4,0,0" Text="{Binding Network.SelectedAdapter.IPv4Label}" Foreground="{StaticResource SecondaryTextBrush}" FontFamily="{StaticResource CodeFontFamily}" FontSize="10" TextWrapping="Wrap" />
                                            <TextBlock Margin="0,9,0,0" Text="IPv6" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" /><TextBlock Margin="0,4,0,0" Text="{Binding Network.SelectedAdapter.IPv6Label}" Foreground="{StaticResource SecondaryTextBrush}" FontFamily="{StaticResource CodeFontFamily}" FontSize="10" TextWrapping="Wrap" />
                                            <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="76" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Шлюз" Foreground="{StaticResource MutedBrush}" /><TextBlock Grid.Column="1" Text="{Binding Network.SelectedAdapter.GatewaysLabel}" FontFamily="{StaticResource CodeFontFamily}" FontSize="10" TextWrapping="Wrap" /></Grid>
                                            <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="76" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="DNS" Foreground="{StaticResource MutedBrush}" /><TextBlock Grid.Column="1" Text="{Binding Network.SelectedAdapter.DnsLabel}" FontFamily="{StaticResource CodeFontFamily}" FontSize="10" TextWrapping="Wrap" /></Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- TCP Stack Tuning Card -->
                                    <Border Margin="0,11,0,0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="17,14">
                                        <StackPanel>
                                            <Grid>
                                                <StackPanel>
                                                    <TextBlock Text="ГЛОБАЛЬНЫЙ TCP-ПРОФИЛЬ" Foreground="{StaticResource MutedBrush}" FontSize="9" FontWeight="Bold" />
                                                    <TextBlock Margin="0,3,0,0" Text="{Binding Network.TcpStatus}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal">
                                                    <Button Margin="0,0,8,0" Padding="10,5" FontSize="10" Style="{StaticResource BaseButton}" Command="{Binding Network.SetTcpNormalCommand}" Content="TCP Normal" />
                                                    <Button Padding="10,5" FontSize="10" Style="{StaticResource BaseButton}" Command="{Binding Network.SetTcpDisabledCommand}" Content="TCP Disabled" />
                                                </StackPanel>
                                            </Grid>
                                            <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Network.TcpSettings}">
                                                <ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,3,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="1" Margin="12,0,0,0" Text="{Binding Value}" Foreground="{StaticResource AccentBrush}" FontFamily="{StaticResource CodeFontFamily}" FontSize="10" /></Grid></DataTemplate></ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="💾 Накопители">
                    <ScrollViewer Margin="0,12,0,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Top Header -->
                            <Grid Margin="0,0,0,13">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="УХОД ЗА НАКОПИТЕЛЯМИ"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="10"
                                               FontWeight="Bold" />
                                    <TextBlock Margin="0,4,0,0"
                                               Text="{Binding Storage.Summary}"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontSize="12"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Margin="0,0,8,0"
                                            Padding="12,7"
                                            Style="{StaticResource BaseButton}"
                                            Command="{Binding Storage.RefreshCommand}"
                                            Content="Обновить" />
                                    <Button Padding="12,7"
                                            Style="{StaticResource BaseButton}"
                                            Command="{Binding Storage.ToggleAdvancedCommand}"
                                            Content="{Binding Storage.AdvancedButtonLabel}" />
                                </StackPanel>
                            </Grid>

                            <!-- SSD Tuning Cards Panel (Visible in both modes) -->
                            <Border Margin="0,0,0,14" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12">
                                <StackPanel>
                                    <Grid Margin="4,0,0,10">
                                        <TextBlock Text="ОПТИМИЗАЦИЯ И РЕСУРС SSD" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                            <Button Margin="0,0,8,0"
                                                    Content="⚡ Оптимизировать всё"
                                                    Style="{StaticResource PrimaryButton}"
                                                    Padding="10,4"
                                                    FontSize="10"
                                                    Command="{Binding Storage.OptimizeAllStorageCommand}"
                                                    ToolTip="Отключить 8.3 имена, LastAccess, службу SysMain и выполнить ReTrim для всех SSD" />
                                            <Button Content="🔄 Восстановить исходные"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Padding="10,4"
                                                    FontSize="10"
                                                    Command="{Binding Storage.RevertCommand}" />
                                        </StackPanel>
                                    </Grid>
                                    <UniformGrid Columns="2">
                                        <!-- 8.3 Names -->
                                        <Border Margin="4" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="Короткие имена NTFS 8.3" FontWeight="SemiBold" FontSize="13" />
                                                <TextBlock Grid.Row="1" Margin="0,4,0,10" Text="Отключает генерацию DOS-псевдонимов имён файлов (PROGRA~1), ускоряя работу с каталогами на NTFS." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" />
                                                <CheckBox Grid.Row="2"
                                                          Style="{StaticResource ToggleSwitch}"
                                                          IsChecked="{Binding Storage.Is8dot3Disabled, Mode=OneWay}"
                                                          Command="{Binding Storage.Toggle8dot3Command}">
                                                    <TextBlock Text="{Binding Storage.Is8dot3StatusLabel}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" FontWeight="SemiBold" />
                                                </CheckBox>
                                            </Grid>
                                        </Border>

                                        <!-- LastAccess Update -->
                                        <Border Margin="4" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="Штамп доступа LastAccess" FontWeight="SemiBold" FontSize="13" />
                                                <TextBlock Grid.Row="1" Margin="0,4,0,10" Text="Исключает постоянную запись штампов последнего доступа при чтении файлов, сберегая ресурс ячеек SSD." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" />
                                                <CheckBox Grid.Row="2"
                                                          Style="{StaticResource ToggleSwitch}"
                                                          IsChecked="{Binding Storage.IsLastAccessDisabled, Mode=OneWay}"
                                                          Command="{Binding Storage.ToggleLastAccessCommand}">
                                                    <TextBlock Text="{Binding Storage.IsLastAccessStatusLabel}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" FontWeight="SemiBold" />
                                                </CheckBox>
                                            </Grid>
                                        </Border>

                                        <!-- Hibernation -->
                                        <Border Margin="4" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="Режим гибернации" FontWeight="SemiBold" FontSize="13" />
                                                <TextBlock Grid.Row="1" Margin="0,4,0,10" Text="{Binding Storage.HiberfilSizeLabel}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" />
                                                <CheckBox Grid.Row="2"
                                                          Style="{StaticResource ToggleSwitch}"
                                                          IsChecked="{Binding Storage.IsHibernationDisabled, Mode=OneWay}"
                                                          Command="{Binding Storage.ToggleHibernationCommand}">
                                                    <TextBlock Text="{Binding Storage.IsHibernationStatusLabel}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" FontWeight="SemiBold" />
                                                </CheckBox>
                                            </Grid>
                                        </Border>

                                        <!-- SysMain (SuperFetch) -->
                                        <Border Margin="4" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="Служба SysMain (SuperFetch)" FontWeight="SemiBold" FontSize="13" />
                                                <TextBlock Grid.Row="1" Margin="0,4,0,10" Text="Устраняет избыточное упреждающее кэширование в RAM, не требующееся для быстрых SSD/NVMe дисков." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" />
                                                <CheckBox Grid.Row="2"
                                                          Style="{StaticResource ToggleSwitch}"
                                                          IsChecked="{Binding Storage.IsSysMainDisabled, Mode=OneWay}"
                                                          Command="{Binding Storage.ToggleSysMainCommand}">
                                                    <TextBlock Text="{Binding Storage.SysMainStatusLabel}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" FontWeight="SemiBold" />
                                                </CheckBox>
                                            </Grid>
                                        </Border>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <!-- UNIFIED DRIVES SECTION -->
                            <Border Margin="0,0,0,16" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <TextBlock Text="НАКОПИТЕЛИ И ОПТИМИЗАЦИЯ TRIM" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" />
                                        <TextBlock HorizontalAlignment="Right" Text="{Binding Storage.Volumes.Count, StringFormat='Обнаружено томов: {0}'}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" />
                                    </Grid>

                                    <!-- List of Volumes -->
                                    <ItemsControl ItemsSource="{Binding Storage.Volumes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,10" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="16,14">
                                                    <StackPanel>
                                                        <!-- Top Row: Volume Letter, Label, Badges & Free Space -->
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" />
                                                                <Border Margin="10,0,0,0" Padding="6,2" Background="{StaticResource AccentDarkBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="4" Visibility="{Binding Volume.IsSystem, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                    <TextBlock Text="СИСТЕМНЫЙ" Foreground="{StaticResource AccentBrush}" FontSize="8" FontWeight="Bold" />
                                                                </Border>
                                                                <Border Margin="6,0,0,0" Padding="6,2" Background="{StaticResource ElevatedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                                                                    <TextBlock Text="{Binding MediaLabel}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="8" FontWeight="Bold" />
                                                                </Border>
                                                            </StackPanel>
                                                            
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding CapacityLabel}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                                                <TextBlock Margin="8,0,0,0" Text="{Binding UsedPercentLabel}" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" />
                                                            </StackPanel>
                                                        </Grid>

                                                        <!-- Usage Bar -->
                                                        <ProgressBar Height="5" Margin="0,10,0,10" Value="{Binding UsedPercent, Mode=OneWay}" Maximum="100" Background="{StaticResource PanelBrush}" Foreground="{StaticResource AccentBrush}" BorderThickness="0" />

                                                        <!-- Action Row: TRIM Button + Status Note -->
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Button Padding="14,7"
                                                                    Style="{StaticResource PrimaryButton}"
                                                                    Command="{Binding DataContext.Storage.RetrimCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    Content="⚡ Оптимизировать TRIM"
                                                                    IsEnabled="{Binding CanRetrim}" />
                                                            <TextBlock Grid.Column="1"
                                                                       Margin="14,0,0,0"
                                                                       VerticalAlignment="Center"
                                                                       Text="{Binding RetrimAvailability.Reason}"
                                                                       Foreground="{StaticResource MutedBrush}"
                                                                       FontSize="10"
                                                                       TextWrapping="Wrap" />
                                                        </Grid>

                                                        <!-- Pro Mode Hardware Descriptors -->
                                                        <Border Margin="0,12,0,0"
                                                                Padding="12,10"
                                                                Background="{StaticResource CardBrush}"
                                                                BorderBrush="{StaticResource BorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="8"
                                                                Visibility="{Binding DataContext.IsProMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Margin="0,0,8,0">
                                                                    <TextBlock Text="{Binding Model, StringFormat='Модель: {0}'}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Margin="0,4,0,0" Text="{Binding DeviceLabel, StringFormat='Интерфейс: {0}'}" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                                    <TextBlock Text="{Binding FileSystemLabel, StringFormat='Файловая система: {0}'}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" />
                                                                    <TextBlock Margin="0,4,0,0" Text="{Binding DeleteNotifyLabel}" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Live Operation Log Box (Visible in Pro mode or after operation) -->
                                    <Border Margin="0,6,0,0"
                                            Background="{StaticResource PanelBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="14,10"
                                            Visibility="{Binding Storage.IsAdvancedVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Storage.LastOperationLabel}" FontSize="9" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Storage.LastOperationFailed}" Value="True"><Setter Property="Foreground" Value="{StaticResource ErrorBrush}" /></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBox Margin="0,6,0,0"
                                                     MaxHeight="90"
                                                     Padding="0"
                                                     Text="{Binding Storage.OperationOutput, Mode=OneWay}"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     Foreground="{StaticResource SecondaryTextBrush}"
                                                     FontFamily="{StaticResource CodeFontFamily}"
                                                     FontSize="9"
                                                     IsReadOnly="True"
                                                     TextWrapping="Wrap"
                                                     VerticalScrollBarVisibility="Auto" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="🧹 Очистка">
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="БЕЗОПАСНАЯ ОЧИСТКА" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" />
                                <TextBlock Margin="0,4,0,0" Text="Сначала сканирование, затем явное подтверждение удаления." Foreground="{StaticResource AccentBrush}" FontSize="12" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <Button Margin="0,0,8,0" Padding="12,7" Style="{StaticResource BaseButton}" Command="{Binding SelectAllCleanupCategoriesCommand}" Content="⚡ Выбрать все категории" />
                                <Button Margin="0,0,8,0" Padding="12,7" Style="{StaticResource BaseButton}" Command="{Binding ScanCleanupCommand}" Content="Сканировать" />
                                <Button Padding="12,7" Style="{StaticResource PrimaryButton}" Command="{Binding CleanCommand}" Content="Удалить найденное" />
                            </StackPanel>
                        </Grid>
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding CleanupCategories}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,9,9" Width="245" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                        <StackPanel>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Content="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Margin="21,5,0,0" Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Grid.Row="2" Margin="0,2,0,10" Text="{Binding CleanupSummary}" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                        <ListBox Grid.Row="3" 
                                 ItemsSource="{Binding CleanupFiles}" 
                                 Background="Transparent" 
                                 BorderBrush="{StaticResource BorderBrush}" 
                                 BorderThickness="1"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                 ScrollViewer.IsDeferredScrollingEnabled="True">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="10,6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding CategoryName}" Foreground="{StaticResource AccentBrush}" FontSize="10" />
                                        <TextBlock Grid.Column="1" Margin="10,0" MaxWidth="540" Text="{Binding FullPath}" Foreground="{StaticResource SecondaryTextBrush}" FontFamily="{StaticResource CodeFontFamily}" FontSize="10" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" HorizontalAlignment="Right" Text="{Binding Length, StringFormat={}{0:N0} Б}" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </TabItem>

                <TabItem Header="🛡️ AtlasOS">
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="ЦЕЛОСТНОСТЬ ATLASOS" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" />
                                <TextBlock Margin="0,4,0,0" Text="{Binding AtlasSummary}" Foreground="{StaticResource AccentBrush}" FontSize="12" />
                            </StackPanel>
                            <Button HorizontalAlignment="Right"
                                    Padding="12,7"
                                    Style="{StaticResource BaseButton}"
                                    Command="{Binding CheckAtlasCommand}"
                                    Content="Проверить AtlasOS" />
                        </Grid>
                        <ListBox Grid.Row="1" ItemsSource="{Binding AtlasChecks}" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Margin" Value="0,0,0,9" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Focusable" Value="False" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="16,13">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" />
                                                <TextBlock Margin="0,5,18,0" Text="{Binding Details}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding StatusLabel}" FontSize="10" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Result.Status}" Value="Healthy"><Setter Property="Foreground" Value="{StaticResource SuccessBrush}" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding Result.Status}" Value="Warning"><Setter Property="Foreground" Value="{StaticResource WarningBrush}" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding Result.Status}" Value="Failed"><Setter Property="Foreground" Value="{StaticResource ErrorBrush}" /></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- STANDALONE HARDWARE MONITORING VIEW -->
        <Grid Grid.Row="1" Visibility="{Binding IsMonitoringVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,6,0">
                    <Grid Margin="0,0,0,13">
                        <StackPanel>
                            <TextBlock Text="СИСТЕМНЫЕ ПОКАЗАТЕЛИ"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="10"
                                       FontWeight="Bold" />
                            <TextBlock Margin="0,4,0,0"
                                       Text="{Binding Monitoring.LastSample}"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="12" />
                        </StackPanel>
                        <Border HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="10,5">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}" />
                                <TextBlock Margin="7,0,0,0"
                                           Text="LIVE"
                                           Foreground="{StaticResource SuccessBrush}"
                                           FontSize="9"
                                           FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <UniformGrid Columns="4" Margin="0,0,0,15">
                        <Border Margin="0,0,7,0"
                                Height="142"
                                Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="15,13">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="ЦП" Foreground="{StaticResource MutedBrush}" FontSize="9" FontWeight="Bold" />
                                <TextBlock Grid.Row="1" Margin="0,5,0,0" Text="{Binding Monitoring.CpuUsage}" FontSize="25" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="2" Margin="0,1,0,0" Text="{Binding Monitoring.CpuName}" ToolTip="{Binding Monitoring.CpuName}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" />
                                <controls:Sparkline Grid.Row="3" Margin="0,8,0,0" Height="31" Values="{Binding Monitoring.CpuHistory}" Stroke="{StaticResource AccentBrush}" />
                            </Grid>
                        </Border>

                        <Border Margin="3,0,5,0"
                                Height="142"
                                Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="15,13">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="ВИДЕОКАРТА" Foreground="{StaticResource MutedBrush}" FontSize="9" FontWeight="Bold" />
                                <TextBlock Grid.Row="1" Margin="0,5,0,0" Text="{Binding Monitoring.GpuUsage}" FontSize="25" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="2" Margin="0,1,0,0" Text="{Binding Monitoring.GpuName}" ToolTip="{Binding Monitoring.GpuName}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" />
                                <controls:Sparkline Grid.Row="3" Margin="0,8,0,0" Height="31" Values="{Binding Monitoring.GpuHistory}" Stroke="{StaticResource AccentBrush}" />
                            </Grid>
                        </Border>

                        <Border Margin="5,0,3,0"
                                Height="142"
                                Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="15,13">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="ОПЕРАТИВНАЯ ПАМЯТЬ" Foreground="{StaticResource MutedBrush}" FontSize="9" FontWeight="Bold" />
                                <TextBlock Grid.Row="1" Margin="0,5,0,0" Text="{Binding Monitoring.MemoryUsage}" FontSize="25" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="2" Margin="0,1,0,0" Text="{Binding Monitoring.MemoryUsageDetails}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" />
                                <controls:Sparkline Grid.Row="3" Margin="0,8,0,0" Height="31" Values="{Binding Monitoring.MemoryHistory}" Stroke="{StaticResource AccentBrush}" />
                            </Grid>
                        </Border>

                        <Border Margin="7,0,0,0"
                                Height="142"
                                Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="15,13">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="СИСТЕМНЫЙ ДИСК" Foreground="{StaticResource MutedBrush}" FontSize="9" FontWeight="Bold" />
                                <TextBlock Grid.Row="1" Margin="0,5,0,0" Text="{Binding Monitoring.DiskUsage}" FontSize="25" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="2" Margin="0,1,0,0" Text="{Binding Monitoring.DiskActivity}" ToolTip="{Binding Monitoring.DiskActivity}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" />
                                <TextBlock Grid.Row="3" Margin="0,9,0,0" Text="Статичный снимок ёмкости" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                            </Grid>
                        </Border>
                    </UniformGrid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="17,14">
                            <StackPanel>
                                <TextBlock Text="ОБОРУДОВАНИЕ" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" />
                                <Grid Margin="0,13,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="ЦП" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Monitoring.CpuName}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                                        <TextBlock Margin="0,3,0,0" Text="{Binding Monitoring.CpuDetails}" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                                    </StackPanel>
                                </Grid>
                                <Border Margin="0,11" Height="1" Background="{StaticResource BorderBrush}" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="GPU" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Monitoring.GpuName}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                                        <TextBlock Margin="0,3,0,0" Text="{Binding Monitoring.GpuDetails}" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                                    </StackPanel>
                                </Grid>
                                <Border Margin="0,11" Height="1" Background="{StaticResource BorderBrush}" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="RAM" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" />
                                    <TextBlock Grid.Column="1" Text="{Binding Monitoring.MemoryDetails}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="17,14">
                            <StackPanel>
                                <TextBlock Text="СИСТЕМА" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" />
                                <Grid Margin="0,13,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="118" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Время работы" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Monitoring.Uptime}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                </Grid>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="118" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Диск" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Monitoring.DriveName}" ToolTip="{Binding Monitoring.DriveDetails}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                                </Grid>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Сеть" Foreground="{StaticResource MutedBrush}" />
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding Monitoring.NetworkActivity}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                        <TextBlock Margin="0,3,0,0" Text="{Binding Monitoring.NetworkName}" ToolTip="{Binding Monitoring.NetworkDetails}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="118" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="План питания" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Monitoring.PowerPlanName}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2"
                    Margin="0,12,0,0"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="13,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="●" FontSize="9" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource InfoBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Foreground" Value="{StaticResource ErrorBrush}" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Margin="9,0,0,0"
                               Text="{Binding StatusMessage}"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
