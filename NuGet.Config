<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The MVP has no external packages. Keeping sources empty makes offline and
       reproducible builds possible. Add reviewed sources only when required. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
